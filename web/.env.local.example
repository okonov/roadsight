NEXTAUTH_SECRET=replace-with-a-random-string
NEXTAUTH_URL=http://localhost:3000

# Microsoft Entra ID sign-in (app registration "roadsight"). All three are required.
# The registration needs a Web redirect URI of <NEXTAUTH_URL>/api/auth/callback/microsoft-entra-id.
AUTH_MICROSOFT_ENTRA_ID_ID=replace-with-application-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=replace-with-client-secret-value
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/replace-with-directory-tenant-id/v2.0

# Optional: without it the app uses the in-memory route repository.
# Local Docker:  postgres://roadsight:roadsight@localhost:5432/roadsight
# Azure:         postgres://<user>:<password>@<server>.postgres.database.azure.com:5432/roadsight_dev?sslmode=require
#DATABASE_URL=postgres://roadsight:roadsight@localhost:5432/roadsight

# Real route resolution needs BOTH of the following. Foundry names the endpoints, Azure
# Maps geocodes them; with either missing the app uses the mock route resolver.
#AZURE_FOUNDRY_API_KEY=replace-with-key-from-roadsight-foundry-resource
#AZURE_FOUNDRY_ENDPOINT=https://roadsight-foundry.services.ai.azure.com
#AZURE_FOUNDRY_DEPLOYMENT=gpt-oss-120b
#AZURE_MAPS_KEY=replace-with-key-from-roadsight-maps-resource
