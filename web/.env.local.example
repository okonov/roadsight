NEXTAUTH_SECRET=replace-with-a-random-string
NEXTAUTH_URL=http://localhost:3000

# Optional: without it the app uses the in-memory route repository.
# Local Docker:  postgres://roadsight:roadsight@localhost:5432/roadsight
# Azure:         postgres://<user>:<password>@<server>.postgres.database.azure.com:5432/roadsight_dev?sslmode=require
#DATABASE_URL=postgres://roadsight:roadsight@localhost:5432/roadsight

# Optional: without it the app uses the mock route resolver.
#AZURE_FOUNDRY_API_KEY=replace-with-key-from-roadsight-foundry-resource
#AZURE_FOUNDRY_ENDPOINT=https://roadsight-foundry.services.ai.azure.com
#AZURE_FOUNDRY_DEPLOYMENT=gpt-oss-120b
