@mapsKey = {{$dotenv AZURE_MAPS_KEY}}

# Structured lookup: addressLine/locality/postalCode/countryRegion. Most accurate when the
# address components are already known — which is NOT the case for AzureMapsGeocoder, whose
# input is a place name from the LLM parser.
### Redmond
@name redmond
GET https://atlas.microsoft.com/geocode
  ?api-version=2026-01-01
  &addressLine=1%20Microsoft%20Way
  &locality=Redmond
  &postalCode=98052
  &countryRegion=US
  &top=1
  &subscription-key={{mapsKey}}

# Freeform lookup — what the app actually does. countryRegion/locality/etc. must NOT be
# combined with `query`; the only geobias is coordinates (Lower Mainland).
### Burnaby
@name burnaby
GET https://atlas.microsoft.com/geocode
  ?api-version=2026-01-01
  &query=Burnaby
  &coordinates=-123.1,49.3
  &top=1
  &subscription-key={{mapsKey}}

# Landmark via the same freeform endpoint (Search v1's Get Search Fuzzy is superseded).
# Check properties.confidence — the only gate signal that is reliably populated — and the
# geocodePoints entry whose usageTypes contains "Route", which is the coordinate
# AzureMapsGeocoder prefers when present.
### Shannon Falls
@name shannonFalls
GET https://atlas.microsoft.com/geocode
  ?api-version=2026-01-01
  &query=Shannon%20Falls%20Provincial%20Park
  &coordinates=-123.1,49.3
  &top=1
  &subscription-key={{mapsKey}}

# Why there is no bbox: adding one wrecks this query. With bbox=-139.1,44.5,-113.5,60.1 it
# returns Low-confidence "Fraser, CO" / "Fraser, AB"; with coordinates alone it returns the
# correct HigherEducationFacility at High confidence.
### SFU (bbox counter-example)
@name sfu
GET https://atlas.microsoft.com/geocode
  ?api-version=2026-01-01
  &query=Simon%20Fraser%20University
  &coordinates=-123.1,49.3
  &top=5
  &subscription-key={{mapsKey}}

# Phase 3b preview: routing takes coordinates only, never labels.
### Route directions
@name directions
POST https://atlas.microsoft.com/route/directions
  ?api-version=2025-01-01
  &subscription-key={{mapsKey}}
Content-Type: application/geo+json

{
  "type": "FeatureCollection",
  "features": [
    {
      "type": "Feature",
      "geometry": { "type": "Point", "coordinates": [-122.8969, 49.2486] },
      "properties": { "pointIndex": 0, "pointType": "waypoint" }
    },
    {
      "type": "Feature",
      "geometry": { "type": "Point", "coordinates": [-123.1567, 49.6702] },
      "properties": { "pointIndex": 1, "pointType": "waypoint" }
    }
  ],
  "travelMode": "driving",
  "optimizeRoute": "fastestWithTraffic",
  "routeOutputOptions": ["routePath"],
  "maxRouteCount": 1
}
